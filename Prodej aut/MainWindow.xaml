<Window x:Class="Prodej_aut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prodej_aut"
        xml:lang="cs-CZ"
        mc:Ignorable="d"
        Title="Prodej vozů"
        Height="600"
        Width="900">

    <Window.Resources>
        <Style x:Key="RightAlignedText"
               TargetType="TextBlock">
            <Setter Property="TextAlignment"
                    Value="Right" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Content="Vybrat XML soubor"
                Click="VybratXml_Click"
                Width="150"
                Height="30"
                HorizontalAlignment="Left" />

        <TextBlock x:Name="TextNazevSouboru"
                   Grid.Row="1"
                   Text="Soubor: -"
                   FontSize="14"
                   Margin="0,10,0,0" />

        <TextBlock Grid.Row="2"
                   Text="Načtené vozy"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,15,0,5" />

        <DataGrid x:Name="TabulkaVozu"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Model"
                                    Binding="{Binding Model}"
                                    Width="*" />

                <DataGridTextColumn Header="Datum prodeje"
                                    Binding="{Binding DatumProdeje, StringFormat={}{0:d.M.yyyy}}"
                                    Width="*" />

                <DataGridTextColumn Header="Cena"
                                    Binding="{Binding Cena, StringFormat={}{0:N2} Kč}"
                                    Width="*"
                                    ElementStyle="{StaticResource RightAlignedText}" />

                <DataGridTextColumn Header="DPH"
                                    Binding="{Binding DPH, StringFormat={}{0:N0} %}"
                                    Width="*" />

            </DataGrid.Columns>

        </DataGrid>


        <TextBlock Grid.Row="4"
                   Text="Víkendové prodeje"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,15,0,5" />

        <DataGrid x:Name="TabulkaVysledku"
                  Grid.Row="5"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Margin="0,0,0,0">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Název modelu"
                                    Binding="{Binding Model}"
                                    Width="*" />

                <DataGridTextColumn Header="Cena bez DPH"
                                    Binding="{Binding CenaBezDph, StringFormat={}{0:N2} Kč}"
                                    Width="*"
                                    ElementStyle="{StaticResource RightAlignedText}" />

                <DataGridTextColumn Header="Cena s DPH"
                                    Binding="{Binding CenaSDph, StringFormat={}{0:N2} Kč}"
                                    Width="*"
                                    ElementStyle="{StaticResource RightAlignedText}" />

            </DataGrid.Columns>

        </DataGrid>
        
        <TextBlock x:Name="TextSouhrn"
                   Grid.Row="6"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,10,0,0"
                   Text="Celkem: -" />

    </Grid>
</Window>